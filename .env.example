# CollegeFootballData API key - free at https://collegefootballdata.com/key
# Copy this file to .env and paste the key. Never commit .env.
CFBD_API_KEY=

# Roboflow serverless workflow (film processing). Workspace Settings → API Keys.
# Never commit the real key.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE=andre-4cotb
ROBOFLOW_WORKFLOW_ID=defensive-coverage-analysis-1789781275490
ROBOFLOW_PLAYER_WORKFLOW_ID=american-football-player-trackin
# Declared parameters on american-football-player-trackin (defaults from the workflow).
ROBOFLOW_PLAYER_CONFIDENCE=0.4
ROBOFLOW_PLAYER_IOU=0.3
ROBOFLOW_TIMEOUT=60
ROBOFLOW_MAX_RETRIES=3
# 1 = detect players, graph them on the UGA minimap, score coverage from BDB tracks.
# 0 = also call the hosted Qwen coverage identifier (experimental).
ROBOFLOW_DETECT_ONLY=1

# Where data lives. Defaults to ./data if unset.
GRIDIRON_DATA_DIR=

# Optional: OpenAI-compatible endpoint for scouting report prose generation.
# The evidence bundle is computed deterministically without this; the LLM only
# writes narrative around numbers it is forbidden to invent.
GRIDIRON_LLM_BASE_URL=
GRIDIRON_LLM_API_KEY=
GRIDIRON_LLM_MODEL=gpt-4o-mini
