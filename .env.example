# CollegeFootballData API key - free at https://collegefootballdata.com/key
# Copy this file to .env and paste the key. Never commit .env.
CFBD_API_KEY=

# Where data lives. Defaults to ./data if unset.
GRIDIRON_DATA_DIR=

# Optional: OpenAI-compatible endpoint for scouting report prose generation.
# The evidence bundle is computed deterministically without this; the LLM only
# writes narrative around numbers it is forbidden to invent.
GRIDIRON_LLM_BASE_URL=
GRIDIRON_LLM_API_KEY=
GRIDIRON_LLM_MODEL=gpt-4o-mini
